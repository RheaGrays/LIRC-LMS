APP_NAME="Library Entrance Monitoring System (LEMS)"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────
# The Electron desktop app automatically uses SQLite — no XAMPP needed.
# DB_DATABASE is overridden at runtime to the writable userData directory.
DB_CONNECTION=sqlite
DB_DATABASE=database/lems.sqlite

# For local web development with MySQL/XAMPP, uncomment below and comment out SQLite above:
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=lems_db
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log

# Command for migration - php artisan migrate --seed
# php artisan migrate --force
# command for backend run - php artisan serve --host=0.0.0.0 --port=8000
