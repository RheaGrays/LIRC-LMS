{
    "name": "lems-kiosk",
    "version": "1.0.0",
    "description": "Cor Jesu College Library Entrance Monitoring & Management System",
    "author": "Cor Jesu College LIRC",
    "private": true,
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "electron": "electron .",
        "electron:admin": "electron . --admin",
        "dist": "electron-builder --win"
    },
    "build": {
        "appId": "com.cjc.lirc.lms",
        "productName": "LIRC Library Management System",
        "directories": {
            "output": "dist"
        },
        "files": [
            "electron/**/*",
            "public/**/*",
            "app/**/*",
            "bootstrap/**/*",
            "config/**/*",
            "database/**/*",
            "resources/**/*",
            "routes/**/*",
            "storage/**/*",
            "vendor/**/*",
            "artisan"
        ],
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.15.12",
        "autoprefixer": "^10.4.2",
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "electron": "^43.2.0",
        "electron-builder": "^25.1.8",
        "laravel-vite-plugin": "^1.2.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^6.0.11"
    },
    "dependencies": {
        "@zxing/browser": "^0.2.1",
        "@zxing/library": "^0.23.0",
        "chart.js": "^4.5.1"
    }
}
