{
    "name": "lems-kiosk",
    "version": "1.0.0",
    "description": "Library Entrance Monitoring System (LEMS) - Cor Jesu College",
    "author": "Cor Jesu College LIRC",
    "private": true,
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "electron": "electron .",
        "electron:admin": "electron . --admin",
        "dist": "electron-builder --win"
    },
    "build": {
        "appId": "com.cjc.lirc.lems",
        "productName": "Library Entrance Monitoring System (LEMS)",
        "asar": false,
        "directories": {
            "output": "dist"
        },
        "files": [
            "electron/**/*",
            "php_bundle/**/*",
            "public/**/*",
            "!public/hot",
            "app/**/*",
            "bootstrap/**/*",
            "config/**/*",
            "database/**/*",
            "resources/**/*",
            "routes/**/*",
            "storage/**/*",
            "vendor/**/*",
            "artisan",
            "server.php",
            ".env",
            "composer.json",
            "composer.lock"
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "public/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "alpinejs": "^3.15.12",
        "autoprefixer": "^10.4.2",
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "electron": "^43.2.0",
        "electron-builder": "^25.1.8",
        "laravel-vite-plugin": "^1.2.0",
        "postcss": "^8.4.31",
        "sharp": "^0.35.3",
        "tailwindcss": "^3.1.0",
        "vite": "^6.0.11"
    },
    "dependencies": {
        "@fontsource/figtree": "^5.3.0",
        "@fontsource/fraunces": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "@fontsource/montserrat": "^5.3.0",
        "@zxing/browser": "^0.2.1",
        "@zxing/library": "^0.23.0",
        "chart.js": "^4.5.1",
        "flatpickr": "^4.6.13",
        "qrcode": "^1.5.4",
        "tom-select": "^2.6.2"
    }
}
